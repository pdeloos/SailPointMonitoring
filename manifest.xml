<?xml version='1.0' encoding='UTF-8'?>
<!DOCTYPE Plugin PUBLIC "sailpoint.dtd" "sailpoint.dtd">
<Plugin name="SailPointMonitoring"
        version="1.2.18"
        minSystemVersion="8.0"
        displayName="Environment Monitoring Plugin">
  <Attributes>
    <Map>
      <entry key="serviceExecutors">
        <value>
          <List>
            <String>com.plugin.monitoring.service.MonitoringService</String>
          </List>
        </value>
      </entry>
      <entry key="fullPage">
        <value>
          <FullPage title="Configuration"/>
        </value>
      </entry>
      <entry key="right" value="ViewIIQ"/>
      <entry key="settings">
        <value>
          <List>
            <Setting dataType="string" name="webserviceBaseUrl" defaultValue="http://localhost:8081/api/events"/>
            <Setting dataType="string" name="webserviceUsername"/>
            <Setting dataType="secret" name="webservicePassword"/>
            <Setting dataType="string" name="bodyTemplate"/>
            <Setting dataType="boolean" name="enableHealthPing" defaultValue="true"/>
            <Setting dataType="boolean" name="enableFailedTasks" defaultValue="true"/>
            <Setting dataType="string" name="failedTasksRegularExpressionFilter"/>
            <Setting dataType="boolean" name="enableFailedProvisioning" defaultValue="true"/>
            <Setting dataType="boolean" name="enableProvisioningDelta" defaultValue="true"/>
            <Setting dataType="int" name="provisioningDeltaWarningPct" defaultValue="20"/>
            <Setting dataType="int" name="provisioningDeltaErrorPct" defaultValue="50"/>
            <Setting dataType="boolean" name="enableApplicationHealth" defaultValue="true"/>
            <Setting dataType="string" name="applicationHealthExcluded"/>
            <Setting dataType="string" name="customRules"/>
            <Setting dataType="string" name="serverComplianceJsonUrl" defaultValue=""/>
            <Setting dataType="boolean" name="enableServerCompliance" defaultValue="true"/>
          </List>
        </value>
      </entry>
      <entry key="settingsForm">
        <value>
          <Form>
            <Section columns="2" label="General settings" name="GeneralSettings">
              <Field columnSpan="2" type="string" helpKey="The url to which monitoring results will be sent" displayName="Web service base url" name="webserviceBaseUrl"/>
              <Field type="string" helpKey="The user name that will be used to authenticate the web service call" displayName="Web service user name" name="webserviceUsername"/>
              <Field type="secret" helpKey="The password that will be used to authenticate the web service call" displayName="Web service password" name="webservicePassword"/>
              <Field type="string" helpKey="The Velocity based body template" displayName="Body template" name="bodyTemplate"/>
            </Section>
            <Section columns="2" label="Health ping settings" name="HealthPingSettings">
              <Field columnSpan="2" type="boolean" helpKey="Enable the plugin to send a health ping" displayName="Enable health ping" name="enableHealthPing"/>
            </Section>
            <Section columns="2" label="Failed tasks reporting" name="FailedTasksReporting">
              <Field type="boolean" helpKey="Enable failed task reporting" displayName="Enable failed task reporting" name="enableFailedTasks"/>
              <Field type="string" helpKey="Only the tasks with a name validating to the regular expression will be reported on" displayName="Failed tasks regular expression filter" name="failedTasksRegularExpressionFilter"/>
            </Section>
            <Section columns="2" label="Failed provisioning actions reporting" name="FailedProvisioningActionsReporting">
              <Field columnSpan="2" type="boolean" helpKey="Enable failed provisioning actions reporting" displayName="Enable failed provisioning reporting" name="enableFailedProvisioning"/>
            </Section>
            <Section columns="2" label="Provisioning action delta reporting" name="ProvisioningActionDeltaReporting">
              <Field columnSpan="2" type="boolean" helpKey="Enable unusual provisioning action delta" displayName="Enable unusual provisioning delta reporting" name="enableProvisioningDelta"/>
              <Field type="int" helpKey="Percentage of provisioning delta where a warning is sent" displayName="Provisioning delta warning percentage" name="provisioningDeltaWarningPct"/>
              <Field type="int" helpKey="Percentage of provisioning delta where an error is sent" displayName="Provisioning delta error percentage" name="provisioningDeltaErrorPct"/>
            </Section>
            <Section columns="2" label="Application health reporting" name="ApplicationHealthReporting">
              <Field type="boolean" helpKey="Enable application health reporting" displayName="Enable application health reporting" name="enableApplicationHealth"/>
              <Field type="string" helpKey="List of applications not to check" displayName="List of applications not to check" multi="true" name="applicationHealthExcluded"/>
            </Section>
            <Section columns="2" label="Server Compliance settings" name="ServerComplianceSettings">
              <Field columnSpan="2" type="boolean" helpKey="Enable server compliance checking" displayName="Enable server compliance check" name="enableServerCompliance"/>
              <Field columnSpan="2" type="string" helpKey="URL to the compliance JSON file" displayName="Compliance JSON URL" name="serverComplianceJsonUrl"/>
            </Section>
            <Section columns="2" label="Custom rule settings" name="CustomRuleSettings">
              <Field type="string" helpKey="List of custom rules to execute" displayName="List of custom rules" multi="true" name="customRules"/>
            </Section>
          </Form>
        </value>
      </entry>
    </Map>
  </Attributes>
</Plugin>
